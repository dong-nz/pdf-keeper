{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Keeper",
  "version": "0.0.3",
  "identifier": "com.pdfkeeper.app",
  "build": {
    "beforeDevCommand": "pnpm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:vite",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Keeper",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*pdfium*"],
    "windows": {
      "nsis": {},
      "wix": {}
    }
  }
}
